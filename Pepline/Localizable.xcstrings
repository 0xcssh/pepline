    "Signing in only ties Pepline Pro to your Apple ID. Deleting the account revokes Pepline's access at Apple." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion relie seulement Pepline Pro à votre identifiant Apple. Supprimer le compte révoque l'accès de Pepline chez Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión solo vincula Pepline Pro a tu Apple ID. Eliminar la cuenta revoca el acceso de Pepline en Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung verknüpft Pepline Pro nur mit deiner Apple-ID. Das Löschen des Kontos entzieht Pepline den Zugriff bei Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso collega solo Pepline Pro al tuo ID Apple. Eliminare l'account revoca l'accesso di Pepline presso Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar apenas vincula o Pepline Pro ao seu ID Apple. Excluir a conta revoga o acesso do Pepline na Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインは Pepline Pro を Apple ID に紐付けるだけです。アカウントを削除すると、Apple 側で Pepline のアクセスが取り消されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인은 Pepline Pro를 Apple ID에 연결할 뿐입니다. 계정을 삭제하면 Apple에서 Pepline의 접근 권한이 취소됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录只会将 Pepline Pro 关联到您的 Apple ID。删除账户会在 Apple 处撤销 Pepline 的访问权限。"
          }
        }
      }
    },
