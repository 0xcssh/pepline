    "%@: 1-month subscription, %@ per month. Auto-renews monthly. Cancel anytime in your App Store settings, at least 24 hours before renewal." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : abonnement d'un mois, %@ par mois. Renouvellement automatique chaque mois. Annulable à tout moment dans les réglages de l'App Store, au moins 24 heures avant le renouvellement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: suscripción de 1 mes, %@ al mes. Se renueva automáticamente cada mes. Cancela cuando quieras en los ajustes del App Store, al menos 24 horas antes de la renovación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 1-Monats-Abo, %@ pro Monat. Verlängert sich automatisch monatlich. Jederzeit in den App-Store-Einstellungen kündbar, mindestens 24 Stunden vor der Verlängerung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
