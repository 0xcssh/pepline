    "Your free trial ends in 2 days. Cancel anytime in your App Store settings if Pepline is not for you." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre essai gratuit se termine dans 2 jours. Annulez à tout moment dans les réglages de l'App Store si Pepline ne vous convient pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu prueba gratuita termina en 2 días. Cancela cuando quieras en los ajustes del App Store si Pepline no es para ti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gratis-Testphase endet in 2 Tagen. Kündige jederzeit in den App-Store-Einstellungen, wenn Pepline nichts für dich ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prova gratuita finisce tra 2 giorni. Annulla quando vuoi nelle impostazioni dell'App Store se Pepline non fa per te."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu teste grátis termina em 2 dias. Cancele quando quiser nos ajustes da App Store se o Pepline não for para você."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料体験はあと2日で終わります。合わなければ App Store の設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 체험이 2일 후 끝납니다. Pepline이 맞지 않으면 App Store 설정에서 언제든 취소하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
