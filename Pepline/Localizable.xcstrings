    "Auto-renews until cancelled. Cancel anytime in your App Store settings, at least 24 hours before renewal." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique jusqu'à annulation. Annulable à tout moment dans les réglages de l'App Store, au moins 24 heures avant le renouvellement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente hasta que canceles. Cancela cuando quieras en los ajustes del App Store, al menos 24 horas antes de la renovación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch bis zur Kündigung. Jederzeit in den App-Store-Einstellungen kündbar, mindestens 24 Stunden vor der Verlängerung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente fino all'annullamento. Annulla quando vuoi nelle impostazioni dell'App Store, almeno 24 ore prima del rinnovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente até ser cancelada. Cancele quando quiser nos ajustes da App Store, pelo menos 24 horas antes da renovação."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解約するまで自動更新されます。更新の24時間前までに App Store の設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소할 때까지 자동 갱신됩니다. 갱신 최소 24시간 전까지 App Store 설정에서 언제든 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动续订，直至取消。可随时在 App Store 设置中取消，需在续订前至少 24 小时。"
          }
        }
      }
    },
