          }
        }
      }
    },
    "Pepline reminds you of the schedule you enter. It does not recommend doses or schedules." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline vous rappelle le protocole que vous saisissez. Il ne recommande ni dose ni protocole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline te recuerda la pauta que introduces. No recomienda dosis ni pautas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline erinnert dich an den Plan, den du einträgst. Es empfiehlt weder Dosen noch Pläne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline ti ricorda lo schema che inserisci. Non consiglia dosi né schemi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pepline lembra você do protocolo que você informa. Ele não recomenda doses nem protocolos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline は入力されたスケジュールを通知します。投与量やスケジュールを推奨することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline은 입력한 일정을 알려 줄 뿐, 투여량이나 일정을 권장하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pepline 只提醒您输入的计划，不推荐任何剂量或计划。"
          }
        }
      }
    },
