    "Set the targets agreed with your doctor or dietitian. Leave a field empty for no goal." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez les objectifs convenus avec votre médecin ou diététicien. Laissez un champ vide pour ne pas fixer d'objectif."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica los objetivos acordados con tu médico o dietista. Deja un campo vacío para no fijar objetivo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
