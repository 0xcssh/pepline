          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir werden %@ berechnet, außer du kündigst vorher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti vengono addebitati %@ a meno che tu non annulli prima."
