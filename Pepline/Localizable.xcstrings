    "Your %@ vial is running low — time to reorder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@-Fläschchen geht zur Neige – Zeit zum Nachbestellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vial de %@ se está acabando: es hora de pedir otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre flacon de %@ touche à sa fin : pensez à en recommander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il flacone di %@ sta per finire: è ora di riordinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のバイアルが残りわずかです。再注文の時期です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 바이알이 거의 떨어졌어요. 재주문할 때예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu frasco de %@ está acabando — hora de pedir outro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 药瓶快用完了，该重新订购了。"
          }
        }
      }
    },
    "Your data stays on this iPhone. No account, no cloud." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données restent sur cet iPhone. Pas de compte, pas de cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en este iPhone. Sin cuenta, sin nube."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf diesem iPhone. Kein Konto, keine Cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati restano su questo iPhone. Nessun account, nessun cloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados ficam neste iPhone. Sem conta, sem nuvem."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはこの iPhone 内に保存されます。アカウントもクラウドも不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터는 이 iPhone에만 저장됩니다. 계정도 클라우드도 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的数据只保存在此 iPhone 上。无需账户，不上传云端。"
          }
        }
      }
    },
    "Your saved data could not be read. Nothing was deleted. Please contact support from Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données enregistrées n'ont pas pu être lues. Rien n'a été supprimé. Contactez le support depuis les Réglages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer tus datos guardados. No se ha borrado nada. Contacta con soporte desde Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gespeicherten Daten konnten nicht gelesen werden. Es wurde nichts gelöscht. Bitte kontaktiere den Support in den Einstellungen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere i dati salvati. Non è stato eliminato nulla. Contatta l'assistenza dalle Impostazioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler seus dados salvos. Nada foi excluído. Fale com o suporte em Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したデータを読み込めませんでした。データは削除されていません。設定からサポートに連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 데이터를 읽을 수 없습니다. 삭제된 것은 없습니다. 설정에서 지원팀에 문의하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已保存的数据。没有任何数据被删除。请在设置中联系支持。"
          }
        }
