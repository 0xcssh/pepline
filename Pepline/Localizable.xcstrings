    "Whatever the goal, it comes down to one number: the units on your syringe." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel que soit l'objectif, tout revient à un chiffre : les unités sur votre seringue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sea cual sea el objetivo, todo se reduce a un número: las unidades de tu jeringa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egal welches Ziel: Es kommt auf eine Zahl an, die Einheiten auf deiner Spritze."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualunque sia l'obiettivo, conta un numero: le unità sulla tua siringa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
