    "Unit conversion only. Pepline does not recommend doses. Follow your prescriber and check with your doctor." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversion d'unités uniquement. Pepline ne recommande aucune dose. Suivez votre prescripteur et parlez-en à votre médecin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo conversión de unidades. Pepline no recomienda dosis. Sigue las indicaciones de tu médico y consúltale."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Einheitenumrechnung. Pepline empfiehlt keine Dosen. Folge deiner Verordnung und sprich mit deinem Arzt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo conversione di unità. Pepline non consiglia dosi. Segui la prescrizione e chiedi al tuo medico."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas conversão de unidades. O Pepline não recomenda doses. Siga a prescrição e consulte seu médico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "単位換算のみを行います。Pepline は投与量を推奨しません。処方に従い、医師に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단위 변환만 제공합니다. Pepline은 투여량을 권장하지 않습니다. 처방을 따르고 의사와 상담하세요."
