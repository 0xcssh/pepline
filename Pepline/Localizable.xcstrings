    "%@: 1-month subscription, %@ per month. Auto-renews monthly. Cancel anytime in your App Store settings, at least 24 hours before renewal." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : abonnement d'un mois, %@ par mois. Renouvellement automatique chaque mois. Annulable à tout moment dans les réglages de l'App Store, au moins 24 heures avant le renouvellement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: suscripción de 1 mes, %@ al mes. Se renueva automáticamente cada mes. Cancela cuando quieras en los ajustes del App Store, al menos 24 horas antes de la renovación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 1-Monats-Abo, %@ pro Monat. Verlängert sich automatisch monatlich. Jederzeit in den App-Store-Einstellungen kündbar, mindestens 24 Stunden vor der Verlängerung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: abbonamento di 1 mese, %@ al mese. Si rinnova automaticamente ogni mese. Annulla quando vuoi nelle impostazioni dell'App Store, almeno 24 ore prima del rinnovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: assinatura de 1 mês, %@ por mês. Renova automaticamente todo mês. Cancele quando quiser nos ajustes da App Store, pelo menos 24 horas antes da renovação."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：1か月のサブスクリプション、月額%@。毎月自動更新されます。更新の24時間前までに App Store の設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 1개월 구독, 월 %@. 매월 자동 갱신됩니다. 갱신 최소 24시간 전까지 App Store 설정에서 언제든 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：1 个月订阅，每月 %@。每月自动续订。可随时在 App Store 设置中取消，需在续订前至少 24 小时。"
          }
        }
      }
    },
    "%@: 1-year subscription, %@ per year. Auto-renews yearly. Cancel anytime in your App Store settings, at least 24 hours before renewal." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : abonnement d'un an, %@ par an. Renouvellement automatique chaque année. Annulable à tout moment dans les réglages de l'App Store, au moins 24 heures avant le renouvellement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: suscripción de 1 año, %@ al año. Se renueva automáticamente cada año. Cancela cuando quieras en los ajustes del App Store, al menos 24 horas antes de la renovación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 1-Jahres-Abo, %@ pro Jahr. Verlängert sich automatisch jährlich. Jederzeit in den App-Store-Einstellungen kündbar, mindestens 24 Stunden vor der Verlängerung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: abbonamento di 1 anno, %@ all'anno. Si rinnova automaticamente ogni anno. Annulla quando vuoi nelle impostazioni dell'App Store, almeno 24 ore prima del rinnovo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: assinatura de 1 ano, %@ por ano. Renova automaticamente todo ano. Cancele quando quiser nos ajustes da App Store, pelo menos 24 horas antes da renovação."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：1年間のサブスクリプション、年額%@。毎年自動更新されます。更新の24時間前までに App Store の設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 1년 구독, 연 %@. 매년 자동 갱신됩니다. 갱신 최소 24시간 전까지 App Store 설정에서 언제든 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
