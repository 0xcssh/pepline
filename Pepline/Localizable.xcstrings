    "Only for compounds dosed in IU. Leave empty otherwise." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour les produits dosés en UI. Sinon, laissez vide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para compuestos dosificados en UI. Si no, déjalo vacío."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Wirkstoffe, die in IE dosiert werden. Sonst leer lassen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per i composti dosati in UI. Altrimenti lascia vuoto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas para compostos dosados em UI. Caso contrário, deixe em branco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IUで投与する成分のみ。それ以外は空欄のままにしてください。"
