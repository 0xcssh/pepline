    "The date your vial runs out, and a reminder to reorder." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La date où votre flacon sera vide, et un rappel pour recommander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fecha en que se acaba tu vial y un recordatorio para volver a pedir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Datum, an dem dein Fläschchen leer ist, und eine Erinnerung zum Nachbestellen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La data in cui il flacone finisce e un promemoria per riordinare."
          }
        },
