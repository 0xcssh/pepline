            "value" : "Questo volume non entra in una siringa: servono %@ prelievi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este volume não cabe em uma seringa: são necessárias %@ aspirações."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この量は1本のシリンジに入りません。%@回に分けて吸引する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 용량은 주사기 하나에 들어가지 않습니다. %@번 나눠 흡입해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此体积一支注射器装不下：需要抽取 %@ 次。"
          }
        }
      }
    },
    "This volume is below the smallest mark of this syringe and cannot be measured accurately." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce volume est sous le plus petit repère de cette seringue et ne peut pas être mesuré avec précision."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este volumen está por debajo de la marca más pequeña de esta jeringa y no se puede medir con precisión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Volumen liegt unter dem kleinsten Teilstrich dieser Spritze und lässt sich nicht genau abmessen."
