        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目的が何であれ、大事なのはひとつの数字。シリンジの単位です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
