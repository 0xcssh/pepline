    },
    "Then let's do your first vial together, step by step." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors faisons votre premier flacon ensemble, étape par étape."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces preparemos tu primer vial juntos, paso a paso."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann machen wir dein erstes Fläschchen zusammen, Schritt für Schritt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora prepariamo insieme il tuo primo flacone, passo dopo passo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então vamos fazer seu primeiro frasco juntos, passo a passo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "では、最初のバイアルを一緒に一歩ずつ進めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그럼 첫 바이알을 함께 단계별로 해 볼게요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那我们一起一步步完成您的第一瓶。"
          }
        }
      }
    },
    "Then you'll like having every vial and schedule in one place." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alors vous aimerez avoir chaque flacon et chaque protocole au même endroit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces te gustará tener cada vial y cada pauta en un solo lugar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann wirst du es mögen, jedes Fläschchen und jeden Plan an einem Ort zu haben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora ti piacerà avere ogni flacone e ogni schema in un unico posto."
          }
        },
        "pt-BR" : {
