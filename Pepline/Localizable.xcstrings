    "Enter the dose your prescriber gave you. Pepline does the math; it never suggests a dose." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez la dose donnée par votre prescripteur. Pepline fait le calcul ; il ne suggère jamais de dose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la dosis que te indicó tu médico. Pepline hace el cálculo; nunca sugiere una dosis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Dosis ein, die dir verordnet wurde. Pepline rechnet; es schlägt nie eine Dosis vor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la dose prescritta. Pepline fa il calcolo; non suggerisce mai una dose."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe a dose que seu médico passou. O Pepline faz a conta; nunca sugere uma dose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処方された投与量を入力してください。Pepline は計算するだけで、投与量を提案することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처방받은 투여량을 입력하세요. Pepline은 계산만 하며 투여량을 제안하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入医生给您的剂量。Pepline 只负责计算，从不建议剂量。"
          }
        }
      }
    },
