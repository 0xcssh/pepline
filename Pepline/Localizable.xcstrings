        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 바이알이 거의 떨어졌어요. 재주문할 때예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
