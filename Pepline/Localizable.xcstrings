    "You're billed %@ unless you cancel before." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes débité de %@, sauf si vous annulez avant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se te cobran %@ salvo que canceles antes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir werden %@ berechnet, außer du kündigst vorher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti vengono addebitati %@ a meno che tu non annulli prima."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você será cobrado %@, a menos que cancele antes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それまでに解約しない限り、%@が請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 전에 취소하지 않으면 %@이(가) 청구됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非提前取消，否则将收取 %@。"
          }
        }
      }
    },
    "Your %@ vial is running low — time to reorder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@-Fläschchen geht zur Neige – Zeit zum Nachbestellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu vial de %@ se está acabando: es hora de pedir otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre flacon de %@ touche à sa fin : pensez à en recommander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il flacone di %@ sta per finire: è ora di riordinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のバイアルが残りわずかです。再注文の時期です。"
