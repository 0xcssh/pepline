    "Less than a tenth of this syringe: read the scale carefully. A smaller syringe is easier to read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins d'un dixième de cette seringue : lisez l'échelle avec attention. Une seringue plus petite est plus facile à lire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de una décima parte de esta jeringa: lee la escala con atención. Una jeringa más pequeña es más fácil de leer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als ein Zehntel dieser Spritze: Lies die Skala sorgfältig. Eine kleinere Spritze ist leichter abzulesen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno di un decimo di questa siringa: leggi la scala con attenzione. Una siringa più piccola è più facile da leggere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de um décimo desta seringa: leia a escala com atenção. Uma seringa menor é mais fácil de ler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このシリンジの容量の10分の1未満です。目盛りを慎重に読んでください。小さいシリンジの方が読みやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주사기 용량의 10분의 1 미만입니다. 눈금을 주의해서 읽으세요. 더 작은 주사기가 읽기 쉽습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
