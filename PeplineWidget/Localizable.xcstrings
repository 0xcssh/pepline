    "Your next dose, its time and the units to draw." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre prochaine dose, son heure et les unités à prélever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu próxima dosis, su hora y las unidades a cargar."
