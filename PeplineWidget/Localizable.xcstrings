          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine nächste Dosis, ihre Uhrzeit und die aufzuziehenden Einheiten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua prossima dose, l'orario e le unità da aspirare."
